# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Authentication
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (test mode — optional for local dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional)
EMAIL_API_KEY=
EMAIL_FROM=noreply@club.suggiglobal.com
SUPPORT_EMAIL=support@suggiglobal.com

# Storage (optional)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Map (optional)
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAP_API_KEY=
